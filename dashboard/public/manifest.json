{
  "name": "Tikchop",
  "short_name": "Tikchop",
  "id": "/dashboard",
  "description": "Boutiques en ligne mobiles avec vendeur WhatsApp automatique.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f4f8f2",
