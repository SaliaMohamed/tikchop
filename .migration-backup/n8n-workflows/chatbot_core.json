{
  "name": "TikTok Sales: Chatbot Core",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-incoming",
        "options": {}
      },
      "name": "Waha Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{$node[\"Waha Webhook\"].json[\"body\"][\"payload\"][\"hasMedia\"]}}",
              "value2": true
            }
          ]
        }
      },
      "name": "Has Image?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "operation": "list",
        "baseId": "YOUR_BASE_ID",
        "tableId": "Products",
        "filters": {
          "filterExpression": "SEARCH(LOWER('{{$node[\"Waha Webhook\"].json[\"body\"][\"payload\"][\"body\"]}}'), LOWER({Name}))"
        }
      },
      "name": "Search Products (Text)",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        500,
        450
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "IMAGE_RECOGNITION_API_URL",
        "sendHeaders": true,
        "headerParametersUi": {
          "parameter": [
            {
              "name": "Authorization",
              "value": "Bearer YOUR_API_KEY"
            }
          ]
        },
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "image_url",
              "value": "={{$node[\"Waha Webhook\"].json[\"body\"][\"payload\"][\"media\"][\"url\"]}}"
            }
          ]
        }
      },
      "name": "AI Image Match",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        500,
        150
      ]
    },
    {
      "parameters": {
        "operation": "list",
        "baseId": "YOUR_BASE_ID",
        "tableId": "Clients",
        "filters": {
          "filterExpression": "{WA_Number} = '{{$node[\"Waha Webhook\"].json[\"body\"][\"payload\"][\"from\"]}}'"
        }
      },
      "name": "Get/Create Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 1,
      "position": [
        750,
        300
      ]
    }
  ],
  "connections": {
    "Waha Webhook": {
      "main": [
        [
          {
            "node": "Has Image?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Image?": {
      "main": [
        [
          {
            "node": "AI Image Match",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Search Products (Text)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
