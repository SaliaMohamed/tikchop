    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst contenus = items.map(i => i.json.contenu).filter(Boolean);\nconst messageFusionne = contenus.join(' [SUITE] ');\nconst idsToUpdate = items.map(i => i.json.id);\nconst phone = items[0].json.client.replace('@c.us', '');\n\nreturn [{\n  json: {\n    message: messageFusionne,\n    phone: phone,\n    batchIds: idsToUpdate\n  }\n}];"
      },
