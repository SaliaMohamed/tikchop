    {
      "parameters": {
        "jsCode": "const message = $json.message || '';\nconst match = message.match(/Ref Commande:\\s*([A-F0-9]+)/i);\nreturn {\n  ref: match ? match[1] : null,\n  phone: $json.phone\n};"
      },
