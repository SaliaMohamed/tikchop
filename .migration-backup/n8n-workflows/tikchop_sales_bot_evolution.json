    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// 1. Fusionner les textes\nconst contenus = items\n  .map(i => i.json.contenu)\n  .filter(Boolean);\n\nlet messageFusionne = contenus.join(' [SUITE] ');\n\n// 2. RÃ©cupÃ©rer les IDs pour la mise Ã  jour\nconst idsToUpdate = items.map(i => i.json.id);\n\n// 3. Infos client\nconst client = items[0].json.client;\n// Extract phone: \"Name : 225... @c.us\" -> \"225...\"\nconst phone = client.split(' : ').pop().replace('@c.us', '').replace('@s.whatsapp.net', '');\n\nreturn [\n  {\n    json: {\n      message: messageFusionne,\n      client: client,\n      phone: phone,\n      batchIds: idsToUpdate\n    }\n  }\n];"
      },
      "id": "23541e90-2614-40f3-82d5-1c46fcafce53",
      "name": "Fusion Pro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
