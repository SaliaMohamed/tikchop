    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\nconst query = input.query || {};\nconst data = body.data || body.message || {};\nconst key = data.key || {};\nconst event = body.event || '';\n\nif (event && !['MESSAGES_UPSERT', 'messages.upsert'].includes(event)) {\n  return [];\n}\n\nif (key.fromMe) {\n  return [];\n}\n\nconst msg = data.message || data;\nconst instanceName = body.instance || body.instanceName || query.seller || 'unknown';\nconst remoteJid = key.remoteJid || data.remoteJid || data.chatId || body.remoteJid || body.chatId || '';\nconst messageId = key.id || data.id || body.id || `${Date.now()}`;\nconst pushName = data.pushName || body.pushName || 'Client';\n\nconst text =\n  msg.conversation ||\n  msg.extendedTextMessage?.text ||\n  msg.imageMessage?.caption ||\n  msg.videoMessage?.caption ||\n  data.messageText ||\n  body.text ||\n  '';\n\nconst mimetype =\n  msg.imageMessage?.mimetype ||\n  msg.audioMessage?.mimetype ||\n  msg.videoMessage?.mimetype ||\n  msg.documentMessage?.mimetype ||\n  '';\n\nif (!text && !mimetype) {\n  return [];\n}\n\nconst payload = {\n  id: messageId,\n  from: remoteJid,\n  body: text,\n  hasMedia: false,\n  media: { mimetype, url: '' },\n  _data: { notifyName: pushName },\n};\n\nreturn [{\n  json: {\n    source: 'evolution',\n    event,\n    instanceName,\n    seller: query.seller || instanceName,\n    query,\n    payload,\n    body: {\n      session: instanceName,\n      payload,\n      event: body.event,\n      instance: instanceName,\n    },\n    raw: body,\n  }\n}];"
      },
      "id": "265ca4c5-1b57-4865-8330-c2f92436a8e7",
      "name": "Normalize Evolution Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -740,
        240
      ]
    },
    {
      "parameters": {
        "jsCode": "const seller = $('Identify Seller').first().json;\nconst nl = String.fromCharCode(10);\nconst orders = $input.all().map(item => item.json).filter(order => Object.keys(order).length > 0);\nconst products = $('Get Products').all().map(item => item.json).map(product => ({\n  id: product.id,\n  name: product.name,\n  price: product.price,\n  stock_quantity: product.stock_quantity,\n  description: product.description,\n  product_url: 'https://tikchop.app/' + seller.slug + '?product=' + product.id,\n}));\nconst shop = $('Get Shop Info').all().map(item => item.json)[0] || {};\nconst productsText = products.length\n  ? products.map((product, index) => {\n      const stock = Number(product.stock_quantity || 0);\n      const availability = stock > 0 ? 'EN STOCK (' + stock + ')' : 'INDISPONIBLE';\n      return (index + 1) + '. ' + product.name + ' - ' + Number(product.price || 0).toLocaleString('fr-FR') + ' CFA - ' + availability + ' - ' + (product.description || 'Pas de description') + ' - Lien: ' + product.product_url;\n    }).join(nl)\n  : 'Aucun produit publie.';\nconst ordersText = orders.length\n  ? orders.map(order => 'Commande ' + (order.order_ref || order.id) + ' - ' + order.status + ' - ' + Number(order.total_amount || 0).toLocaleString('fr-FR') + ' CFA').join(nl)\n  : 'Aucune commande connue pour ce client.';\nconst shopText = Object.keys(shop).length ? ('Boutique: ' + (shop.name || seller.name || '') + ' - Livraison: ' + (shop.delivery_payment_timing || 'non renseignee') + ' - Frais: ' + Number(shop.fixed_delivery_fee || 0).toLocaleString('fr-FR') + ' CFA') : 'Infos livraison non renseignees.';\nreturn [{ json: { orders, products, shop, productsText, ordersText, shopText } }];"
      },
      "id": "prepare-ai-context-node",
      "name": "Prepare AI Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
