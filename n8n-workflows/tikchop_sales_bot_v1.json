{
  "name": "TikTok Sales Bot: Full Experience (Adapted from PLA)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-incoming",
        "options": {}
      },
      "name": "WAHA Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$node[\"WAHA Trigger\"].json[\"body\"][\"payload\"][\"body\"]}}",
              "operation": "contains",
              "value2": "Ref Commande:"
            }
          ]
        }
      },
      "name": "Check Ref Commande",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        300,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $node[\"WAHA Trigger\"].json[\"body\"][\"payload\"][\"body\"];\nconst match = body.match(/Ref Commande:\\s*([A-F0-9]+)/i);\nreturn {\n  ref: match ? match[1] : null,\n  phone: $node[\"WAHA Trigger\"].json[\"body\"][\"payload\"][\"from\"]\n};"
      },
      "name": "Extract Ref",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        500,
        150
      ]
    },
    {
      "parameters": {
        "operation": "list",
        "tableName": "orders",
        "filters": {
          "customFilter": "id::text ilike '{{$node[\"Extract Ref\"].json[\"ref\"]}}%'"
        }
      },
      "name": "Find Order",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        700,
        150
      ],
      "credentials": {
        "supabaseApi": "YOUR_SUPABASE_CREDENTIALS"
      }
    },
    {
      "parameters": {
        "operation": "update",
        "tableName": "orders",
        "id": "={{$node[\"Find Order\"].json[\"id\"]}}",
        "fields": {
          "customer_phone": "={{$node[\"Extract Ref\"].json[\"phone\"]}}"
        }
      },
      "name": "Link Order to Phone",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        900,
        150
      ],
      "credentials": {
        "supabaseApi": "YOUR_SUPABASE_CREDENTIALS"
      }
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "promptType": "define",
        "text": "={{$node[\"WAHA Trigger\"].json[\"body\"][\"payload\"][\"body\"]}}",
        "options": {
          "systemMessage": "= IDENTITÉ :\nVous êtes l'assistant de vente de Tikchop. Vous aidez les clients à acheter des articles de mode et accessoires.\n\nCONSIGNES :\n1. Soyez court, amical et vendeur.\n2. Si un client demande des détails sur un produit, donnez-les.\n3. Si un client a envoyé une référence de commande ({{$node[\"Extract Ref\"].json[\"ref\"]}}), confirmez que la commande est reçue.\n\nPRODUITS DISPONIBLES :\n{{$node[\"Get Products\"].json}}"
        }
      },
      "name": "AI Assistant (Brain)",
      "type": "n8n-nodes-base.agent",
      "typeVersion": 1,
      "position": [
        500,
        450
      ]
    },
    {
      "parameters": {
        "operation": "list",
        "tableName": "products",
        "limit": 50
      },
      "name": "Get Products",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        300,
        550
      ],
      "credentials": {
        "supabaseApi": "YOUR_SUPABASE_CREDENTIALS"
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "YOUR_WAHA_URL/api/sendText",
        "sendBody": true,
        "bodyParametersUi": {
          "parameter": [
            {
              "name": "chatId",
              "value": "={{$node[\"WAHA Trigger\"].json[\"body\"][\"payload\"][\"from\"]}}"
            },
            {
              "name": "text",
              "value": "={{$node[\"AI Assistant (Brain)\"].json[\"output\"]}}"
            }
          ]
        }
      },
      "name": "Send Reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 1,
      "position": [
        1200,
        300
      ]
    }
  ],
  "connections": {
    "WAHA Trigger": {
      "main": [
        [
          {
            "node": "Check Ref Commande",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Ref Commande": {
      "main": [
        [
          {
            "node": "Extract Ref",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "AI Assistant (Brain)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Ref": {
      "main": [
        [
          {
            "node": "Find Order",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Order": {
      "main": [
        [
          {
            "node": "Link Order to Phone",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Link Order to Phone": {
      "main": [
        [
          {
            "node": "AI Assistant (Brain)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Products": {
      "main": [
        [
          {
            "node": "AI Assistant (Brain)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Assistant (Brain)": {
      "main": [
        [
          {
            "node": "Send Reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {}
}
